# FarmFeed Environment Configuration

# ===== Local Development (defaults) =====
# Leave these unset to use localhost MySQL with no SSL
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=farmfeed
# DB_USER=farmfeed
# DB_PASSWORD=farmfeed_password

# ===== Aiven Cloud Production =====
# For Aiven MySQL deployments, set these environment variables:
# DB_HOST=your-aiven-instance.aivencloud.com
# DB_PORT=21234 (or your Aiven port)
# DB_NAME=farmfeed
# DB_USER=avnadmin (or your Aiven user)
# DB_PASSWORD=your-aiven-password
# DB_USE_SSL=true
# DB_REQUIRE_SSL=true

# ===== Application Configuration =====
# PORT=8080
# SPRING_PROFILES_ACTIVE=production

# ===== Vercel Deployment =====
# Set DB_HOST, DB_PORT, DB_USER, DB_PASSWORD in Vercel project settings:
# https://vercel.com/docs/environment-variables
