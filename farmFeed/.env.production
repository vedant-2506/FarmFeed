# ===== RENDER DEPLOYMENT =====
RENDER_ENV=production

# ===== AIVEN MySQL Configuration =====
# Replace these with your Aiven connection details
# Get from: https://console.aiven.io -> Your Project -> MySQL -> Connection Information
DB_HOST=your-aiven-mysql-host
DB_PORT=your-aiven-mysql-port
DB_USER=your-aiven-mysql-user
DB_PASS=your-aiven-mysql-password
DB_URL=jdbc:mysql://your-aiven-mysql-host:your-aiven-mysql-port/farmfeed_db?createDatabaseIfNotExist=true&useSSL=true&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_DRIVER=com.mysql.cj.jdbc.Driver
JPA_DIALECT=org.hibernate.dialect.MySQLDialect

# ===== VERCEL FRONTEND =====
REACT_APP_API_BASE_URL=https://your-render-backend-url.onrender.com
